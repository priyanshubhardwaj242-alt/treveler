# ============================================================
# WAYPOINT — environment variables
# Copy this file to .env.local and fill in the values you have.
# Anything left blank falls back to mock/demo behavior automatically
# (see src/lib/places.ts, src/lib/email.ts) so the app runs with
# ZERO keys filled in — just `npm install && npm run db:push && npm run dev`.
# ============================================================

# ---- Database ----------------------------------------------
# Any Postgres connection string. Fastest free option: https://supabase.com
# -> New project -> Settings -> Database -> Connection string (URI, "Session" mode)
# For quick local testing without Postgres, swap prisma/schema.prisma
# datasource provider to "sqlite" and use: DATABASE_URL="file:./dev.db"
DATABASE_URL=""

# ---- NextAuth -------------------------------------------------
# Any random 32+ char string. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---- Google OAuth (for "Sign in with Google") ------------------
# https://console.cloud.google.com/apis/credentials
# -> Create Credentials -> OAuth Client ID -> Web application
# -> Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Google Maps Platform ---------------------------------------
# https://console.cloud.google.com/google/maps-apis/credentials
# One key, with these APIs enabled on it in the Cloud Console:
#   Maps JavaScript API, Places API, Geocoding API,
#   Directions API, Distance Matrix API
# Client-safe key (restrict to your domain + the above APIs only):
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
# Server-side key used by API routes (can be the same key, restricted by IP instead):
GOOGLE_MAPS_SERVER_KEY=""

# ---- Transactional email (password reset, trip reminders) ------
# https://resend.com -> API Keys -> Create API Key
RESEND_API_KEY=""
EMAIL_FROM="Waypoint <onboarding@resend.dev>"

# ---- Weather alerts (optional) ----------------------------------
# https://openweathermap.org/api -> free tier API key
OPENWEATHER_API_KEY=""
