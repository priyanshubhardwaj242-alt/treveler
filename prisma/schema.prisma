// Waypoint database schema
// Swap `provider = "postgresql"` for "sqlite" for zero-setup local dev
// (see .env.example for the matching DATABASE_URL format).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only accounts
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  trips    Trip[]

  resetToken       String?
  resetTokenExpiry DateTime?
}

// --- NextAuth required models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain models ---
model Trip {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  destination   String
  startLocation String?
  budget        Float
  days          Int
  travelers     Int
  startDate     DateTime?
  endDate       DateTime?
  dayStart      String   @default("08:30")
  dayEnd        String   @default("19:30")

  hotelTier       String  @default("Standard")
  interests       String[] // e.g. ["Nature","Food","Temples"]
  transportPref   String[] // e.g. ["Own Car"]

  accommodationMode String  @default("suggest") // "have" | "suggest"
  hotelName         String?
  hotelAddress      String?
  hotelLat          Float?
  hotelLng          Float?
  hotelPricePerNight Float?

  transportMode   String  @default("own") // "own" | "need"
  transportChoice String?

  selectedPlaceIds String[] // Google Place IDs chosen by the user
  itineraryJson    Json?    // cached optimizer output (days -> stops)

  status    String   @default("draft") // draft | planned | completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
